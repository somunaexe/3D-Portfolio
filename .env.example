# Where the chatbot service (chatbot/src/api.py) is running. Not a secret: it ends up in the built site.
# In development it defaults to http://localhost:8000. For a production build, set it (in GitHub: repo
# Settings > Secrets and variables > Actions > Variables > VITE_CHATBOT_URL). If it is empty in a
# production build, the chat icon is not shown.
VITE_CHATBOT_URL=http://localhost:8000
